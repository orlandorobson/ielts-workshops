{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ielts-classroom-release",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://orlandorobson.github.io,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://192.168.1.103:8001" },
  "durable_objects": { "bindings": [{ "name": "CLASSROOMS", "class_name": "Classroom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Classroom"] }]
}
